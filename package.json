{
  "name": "skills",
  "version": "0.1.0",
  "description": "Agent skills for tests, CI, reviews, feature workflows and browser-based visual proof",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathnael-desta/skills.git"
  },
  "homepage": "https://github.com/nathnael-desta/skills#readme",
  "bugs": "https://github.com/nathnael-desta/skills/issues",
  "type": "module",
  "files": [
    "*/SKILL.md",
    "*/references/**",
    "*/templates/**",
    "docs/**",
    "scripts/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format:check": "prettier --check README.md package.json scripts/**/*.mjs docs/**/*.md '*/SKILL.md'",
    "test": "node scripts/validate.mjs && npm run format:check",
    "verify:skills": "npx skills@latest add . --list",
    "format": "prettier --write README.md package.json '*/SKILL.md'"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "opencode",
    "codex",
    "testing",
    "ci"
  ]
}
